      "queryLines": [
        "select * from stock_data.default.gold_daily_stock_data;"
      ]
    },
    {
      "name": "eca8665b",
      "displayName": "Weekly_DashBoards",
      "queryLines": [
        "SELECT * FROM stock_data.default.gold_weekly_stock_data;\r\n"
      ],
      "columns": [
        {
          "displayName": "trading_spread",
          "description": "Trading volume spread: difference between high and low prices",
          "expression": "`high` - `low`"
        }
      ]
    },
    {
      "name": "58ab2246",
      "displayName": "Monthly_Dashboards",
      "queryLines": [
        "SELECT * FROM stock_data.default.gold_monthly_stock_data;\r\n"
      ],
      "columns": [
        {
          "displayName": "daily_return_range",
          "description": "Daily return percentage range: max minus min per month",
          "expression": "`daily_return_pct_max` - `daily_return_pct_min`"
        }
      ]
    },
    {
      "name": "d4eaa13c",
      "displayName": "Top_gainers",
